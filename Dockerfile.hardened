# Hardened Dockerfile
# Remediates all five findings from the vulnerable Dockerfile.
# See REMEDIATION.md for the full before/after technical breakdown.

# FIXED 1: Pinned to a specific SHA digest - cryptographically immutable.
# If the upstream image changes, this digest will not match and the build
# fails rather than silently pulling a potentially compromised image.
# MITRE ATT&CK T1195.002 - Compromise Software Supply Chain.
# Digest verified for linux/amd64 platform (May 2026)
FROM python:3.9-slim@sha256:dad5b29e3506c35e0fd222736f4d4ef25d21b219acdd73f7bb41d59996ca8e0d

# FIXED 2: Non-root user created and applied before CMD.
# Application process runs as UID 1001 with only the permissions it needs.
# Principle of least privilege. CIS Docker Benchmark 4.1.
RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --shell /bin/sh --create-home appuser

# FIXED 3: Minimal runtime dependencies only.
# curl, wget, vim, and net-tools removed - none are required at runtime.
# Only libsqlite3-0 is retained as a genuine application dependency.
# python:3.9-slim base ships without the unnecessary packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-hardened.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY src/remediated_app.py ./src/

# FIXED 4: HEALTHCHECK added.
# Allows Docker and container orchestrators (ECS, Kubernetes) to detect
# whether the application is alive and serving requests. A process that
# has crashed or deadlocked will fail the health check and be restarted
# automatically. CIS Docker Benchmark 4.6.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

EXPOSE 5000

USER appuser

# FIXED 5: Exec form CMD - signals delivered directly to Python as PID 1.
# Shell form wraps the process in /bin/sh -c, which intercepts SIGTERM.
# Exec form ensures graceful shutdown when the container is stopped.
CMD ["python", "src/remediated_app.py"]
